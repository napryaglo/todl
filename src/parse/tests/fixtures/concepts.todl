namespace adl.metaModels.bpmn.concepts
{
    import adl.metaModels.bpmn.primitives.Identifier;
    import adl.metaModels.bpmn.enums.TaskType;

    concept EventTrigger { }

    concept FlowType { }

    concept Task
    {
        description = "An atomic activity in the process.";

        label    : string;
        type     : TaskType;
        assignee : string?;

        relationship livesIn -> Lane;
        relationship incoming -> SequenceFlow[];
        relationship outgoing -> SequenceFlow[];

        invariant "Task ids are unique within the process.";
        invariant
        {
            description = "A service or script task should carry no assignee — no human in the loop.";
            predicate   = (this.type == service || this.type == script)
                            implies this.assignee == none;
        }
    }

    concept Event
    {
        description = "Something that happens in the process.";

        label      : string?;
        eventType : EventType;
        trigger    : EventTrigger?;

        relationship livesIn -> Lane;
        relationship incoming -> SequenceFlow[];
        relationship outgoing -> SequenceFlow[];

        invariant
        {
            description = "Start events have no incoming sequence flows.";
            predicate   = This.EventType == start implies this.incoming.empty;
        }
        invariant
        {
            description = "End events have no outgoing sequence flows.";
            predicate   = This.EventType == end implies this.outgoing.empty;
        }
    }
}
