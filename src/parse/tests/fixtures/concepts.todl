namespace adl.meta-models.bpmn.concepts
{
    import adl.meta-models.bpmn.primitives.identifier;
    import adl.meta-models.bpmn.enums.task-type;

    concept event-trigger { }

    concept flow-type { }

    concept task
    {
        description = "An atomic activity in the process.";

        label    : string;
        type     : task-type;
        assignee : string?;

        relationship lives-in -> lane;
        relationship incoming -> sequence-flow[];
        relationship outgoing -> sequence-flow[];

        invariant "Task ids are unique within the process.";
        invariant
        {
            description = "A service or script task should carry no assignee — no human in the loop.";
            predicate   = (this.type == service || this.type == script)
                            implies this.assignee == none;
        }
    }

    concept event
    {
        description = "Something that happens in the process.";

        label      : string?;
        event-type : event-type;
        trigger    : event-trigger?;

        relationship lives-in -> lane;
        relationship incoming -> sequence-flow[];
        relationship outgoing -> sequence-flow[];

        invariant
        {
            description = "Start events have no incoming sequence flows.";
            predicate   = this.event-type == start implies this.incoming.empty;
        }
        invariant
        {
            description = "End events have no outgoing sequence flows.";
            predicate   = this.event-type == end implies this.outgoing.empty;
        }
    }
}
