namespace adl.meta-models.bpmn.enums
{
    taxonomy task-type
    {
        description = "Classifies a BPMN task by what kind of work performs it.";
        terms
        {
            | none    { label = "Unspecialised"; }
            | user    { label = "User Task"; }
            | service { label = "Service Task"; }
            | manual  { label = "Manual Task"; }
            | script  { label = "Script Task"; }
            | send    { label = "Send Task"; }
            | receive { label = "Receive Task"; }
        }
    }

    taxonomy event-type
    {
        description = "Position of an event in the flow.";
        terms
        {
            | start        { label = "Start"; }
            | intermediate { label = "Intermediate"; }
            | end          { label = "End"; }
        }
    }
}
