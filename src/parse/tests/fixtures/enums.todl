namespace adl.metaModels.bpmn.enums
{
    taxonomy TaskType : represents Task
    {
        description = "Classifies a BPMN task by what kind of work performs it.";
        term None    { label = "Unspecialised"; }
        term User    { label = "User Task"; }
        term Service { label = "Service Task"; }
        term Manual  { label = "Manual Task"; }
        term Script  { label = "Script Task"; }
        term Send    { label = "Send Task"; }
        term Receive { label = "Receive Task"; }
    }

    taxonomy EventType : represents Event
    {
        description = "Position of an event in the flow.";
        term Start        { label = "Start"; }
        term Intermediate { label = "Intermediate"; }
        term End          { label = "End"; }
    }
}
