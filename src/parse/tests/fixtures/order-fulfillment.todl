namespace demo.order-fulfillment
{
    lane sales { label = "Sales"; }

    event-trigger message { }

    flow-type sequence { }

    event order-placed
    {
        label      = "Order Placed";
        event-type = event-type.start;
        trigger    = message;
        lives-in   = sales;
        outgoing   = [order-to-validate];
    }

    task validate-payment
    {
        label    = "Validate Payment";
        type     = task-type.service;
        lives-in = sales;
        incoming = [order-to-validate];
    }

    sequence-flow order-to-validate
    {
        from = order-placed;
        to   = validate-payment;
        type = sequence;
    }
}
