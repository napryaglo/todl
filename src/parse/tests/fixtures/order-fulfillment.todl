namespace demo.orderFulfillment
{
    Lane sales { label = "Sales"; }

    EventTrigger message { }

    FlowType sequence { }

    Event orderPlaced
    {
        label      = "Order Placed";
        eventType = EventType.Start;
        trigger    = message;
        livesIn   = sales;
        outgoing   = [orderToValidate];
    }

    Task validatePayment
    {
        label    = "Validate Payment";
        type     = TaskType.Service;
        livesIn = sales;
        incoming = [orderToValidate];
    }

    SequenceFlow orderToValidate
    {
        from = orderPlaced;
        to   = validatePayment;
        type = sequence;
    }
}
