{
  "name": "@pragmatic-lab/todl",
  "version": "0.3.0",
  "description": "Typed substrate for authoring and reasoning over ontologies and taxonomies",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.js"
      }
    },
    "./language-service": {
      "types": "./dist/language-service/index.d.ts",
      "import": {
        "development": "./src/language-service/index.ts",
        "default": "./dist/language-service/index.js"
      }
    },
    "./language-server": {
      "types": "./dist/language-server/index.d.ts",
      "import": {
        "development": "./src/language-server/index.ts",
        "default": "./dist/language-server/index.js"
      }
    }
  },
  "bin": {
    "todl-language-server": "./dist/language-server/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "http://localhost:4873/",
    "access": "public"
  },
  "scripts": {
    "test": "tsx --conditions=development --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
